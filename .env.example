# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=Asia/Jakarta

# Admin path. Change it in production, keep the trailing slash.
DJANGO_ADMIN_URL=admin/

# Akun admin pertama untuk `make seed` -----------------------------------------
# Nilai di bawah adalah kredensial DEVELOPMENT dan diketahui publik lewat repo
# ini. Ganti sebelum dipakai di mana pun selain mesin lokal. Di server, pakai
# `make superuser` (interaktif) supaya password tidak pernah singgah di file.
DJANGO_SEED_ADMIN_EMAIL=admin@ops.local
DJANGO_SEED_ADMIN_PASSWORD=OpsViews!Dev2026

# Akun test non-admin untuk `make seed-dummy` -----------------------------------
# Staff, TAPI BUKAN superuser - beda dari akun admin di atas, akun ini tunduk
# ke apps.access.FeatureGrant (superuser selalu bypass), jadi berguna untuk
# menguji hak akses menu secara manual. Belum punya akses apa pun sampai
# diberi grant lewat admin (Access -> Feature grants). Nilai di bawah juga
# kredensial DEVELOPMENT publik - lihat catatan di atas.
DJANGO_SEED_DUMMY_EMAIL=dummy@ops.local
DJANGO_SEED_DUMMY_PASSWORD=OpsViews!Dummy2026

# Public title of the admin (alias cms_ops) - browser tab & sidebar header.
DJANGO_SITE_TITLE=CMS Ops

# Database -------------------------------------------------------------------
# Project ini memakai container PostgreSQL bersama yang sudah jalan di mesin
# ini (nama container: `postgres`, port host 55432) - bukan container sendiri.
# Lihat README bagian "Database" untuk membuat role & database-nya.
# postgres: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# sqlite (tidak dipakai project ini): sqlite:////absolute/path/ke/db.sqlite3
DATABASE_URL=postgres://ops_user:PASSWORD_DARI_SETUP@127.0.0.1:55432/ops_views
DATABASE_CONN_MAX_AGE=60
# disable | allow | prefer | require | verify-ca | verify-full
# disable di lokal (Postgres di loopback/docker), require di server remote
DATABASE_SSLMODE=disable

# Cache ------------------------------------------------------------------
# Project ini memakai container Redis bersama yang sudah jalan di mesin ini
# (nama container: `redis`, port 6379) - bukan container sendiri, sama seperti
# PostgreSQL. Isolasi dari project lain lewat nomor database (bukan 0) dan
# CACHE_KEY_PREFIX (default "ops_views", diset di base.py), bukan container
# terpisah. Lihat README bagian "Cache".
# redis://[:PASSWORD]@HOST:PORT/DB_INDEX
# Kosong -> fallback locmem (in-process), cukup untuk `check`/`test` tanpa Redis.
REDIS_URL=redis://:PASSWORD_DARI_SETUP@127.0.0.1:6379/1

# Email ----------------------------------------------------------------------
# consolemail://                      (prints to stdout, dev only)
# smtp://USER:PASSWORD@HOST:587/?tls=True
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=ops-views@localhost

# Production only ------------------------------------------------------------
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ops.example.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_ADMINS=Ops Team:ops@example.com
